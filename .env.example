# Wrangler reads .env for local development. Do not also create .dev.vars.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID; only this user in a private chat is accepted.
TELEGRAM_USER_ID=
# Generate separate random values (32+ characters) for these three secrets.
TELEGRAM_WEBHOOK_SECRET=
STRAVA_WEBHOOK_SECRET=
STRAVA_VERIFY_TOKEN=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Public HTTPS Worker origin, no trailing slash. Set after approved deployment.
PUBLIC_URL=
